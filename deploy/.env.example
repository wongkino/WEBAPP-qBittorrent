# ── Production Docker runtime ──
# Copy this file to `deploy/.env` and set real values there.
# Do NOT commit `deploy/.env`.
# See docs/reference/environment.md and docs/guides/deployment.md.

# 連線 qBittorrent 的 Basic 認證。瀏覽器看不到這組帳密。
QBITTORRENT_URL=http://192.168.1.10:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Pocket ID（OIDC）。Issuer 不要尾端 /。Callback 必須與 Pocket ID 用戶端完全一致。
# Pocket ID 用戶端：不要勾 Public Client；要勾 PKCE。
# AUTH_SECRET：openssl rand -base64 32
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://qb.example.com/api/auth/callback
AUTH_SECRET=
# 選填。逗號分隔；留空則接受這個 OIDC 用戶端登入成功的任何人。
# OIDC_ALLOWED_EMAILS=you@example.com
