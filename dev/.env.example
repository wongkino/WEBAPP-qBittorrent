# ── Development only (`npm run dev`) ──
# Next.js loads this as `.env.development.local` (not used by production builds).
#
#   cp dev/.env.example .env.development.local

# qBittorrent Web UI (no trailing slash).
# Docker dev：若 qB 跑在本機，用 host.docker.internal 取代 localhost。
# 連線 qBittorrent 的 Basic 認證。
QBITTORRENT_URL=http://192.168.1.10:8080
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=

# Pocket ID（OIDC）。本機 callback 例：http://localhost:3000/api/auth/callback
# Pocket ID 用戶端：不要勾 Public Client；要勾 PKCE。
OIDC_ISSUER=https://id.example.com
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
AUTH_SECRET=
# OIDC_ALLOWED_EMAILS=you@example.com
