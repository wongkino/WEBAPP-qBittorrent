{
  "name": "qbittorrent-web-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:env": "cp dev/.env.example .env.development.local",
    "dev:docker": "DEV_ALLOWED_ORIGINS=$(node dev/scripts/lan-ip.mjs) docker compose -f dev/docker/compose.yaml up --build",
    "dev:docker:down": "docker compose -f dev/docker/compose.yaml down",
    "build": "next build",
    "start": "next start",
    "prod:env": "cp deploy/.env.example deploy/.env",
    "prod:up": "docker compose -f deploy/compose.yaml up -d --build",
    "lint": "eslint"
  },
  "dependencies": {
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "typescript": "^5"
  }
}
